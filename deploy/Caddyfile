# Install this only after the private DNS name and client trust path have been
# approved. The simulation itself remains loopback-only; Caddy is the sole
# browser-facing boundary.

genesisengine.local {
    tls internal

    root * /opt/genesis-engine/current/observer
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8940
    }

    handle /metrics {
        reverse_proxy 127.0.0.1:8940
    }

    handle /ws {
        reverse_proxy 127.0.0.1:8941
    }

    handle {
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }
}
