# Phase 16 confirmatory campaign (C16.5, C16.6). Pre-registered in
# experiments/phase16-transition-preregistration.md BEFORE this file ran;
# the observables, decision rules and expectations are fixed there, from
# the Stage B pilot on disjoint seeds. Seeds 17001..17030 (30, disjoint
# from every prior decision range; every one probed generable at 64x64
# on 2026-09-02). The four arms differ from N in exactly their declared
# variables; production TOTAL is identical by construction.
#
# EXPECTED OUTCOME, STATED IN ADVANCE: materialization in 28+ of 30 under
# N, S2 and S4 (first at 20-30k ticks), none under T0; the influx rate is
# the per-tick cap; births rare; C16.6 null (0 of 30 above one module).
campaign phase16-transition-confirmatory
ticks 60000
workers 8
seeds 17001..17030
check-interval 5000
base preset phase2
base cells_x 64
base cells_y 64
base initial_organisms 0
base max_entities 4000
base origin.mode scratch
base genome2.enabled true
base genome2.mutation.duplication_q16 6554
base genome2.mutation.deletion_q16 655
base genome2.mutation.insertion_q16 0
base genome2.mutation.transposition_q16 0
base genome2.caps.max_loci_per_chromosome 160
base genome2.caps.max_nodes 160
base genome2.caps.max_edges 160
base genome2.caps.max_edges_per_node 32
base genome2.caps.max_genome_bytes 16384
base morphology.enabled true
base morphology.caps.max_modules 64
base morphology.caps.lattice_radius 8
base morphology.caps.max_growth_steps 16
base morphology.base_node_budget 4
base chemistry.enabled true
base chemistry.field_steps_per_tick 1
base chemistry.microbial_enabled true
base chemistry.abiogenesis_enabled true
base chemistry.mutation_q16 4096
base chemistry.excretion_fraction_q16 32768
base chemistry.remains_fraction_q16 32768
base transition.enabled true
base transition.check_interval_ticks 100
base transition.density_floor_milli 4000
base transition.persistence_checks 5
base transition.aggregation_step_min 1
base transition.organism_energy_milli 4000
base transition.max_organisms_per_event 4
base transition.max_materializations_per_tick 64
condition T0
condition N
condition S2
condition S4
set T0 transition.enabled false
set S2 chemistry.scaffold_patch_radius_cells 3
set S2 chemistry.scaffold_patch_contrast_q16 131072
set S4 chemistry.scaffold_patch_radius_cells 3
set S4 chemistry.scaffold_patch_contrast_q16 262144
vary transition.enabled
vary chemistry.scaffold_patch_radius_cells
vary chemistry.scaffold_patch_contrast_q16
output events off
output snapshots on
output field 500
