# Phase 23 pilot (ADR-0038): the field's production swept under BOTH intake
# orders on four seeds disjoint from the confirmatory's, 100,000 ticks.
# Under the shipped order (the youngest eats last): P1 the shipped 2 milli
# per cell per step (control), P4 8, P16 32, P64 128 (64 percent of a
# 200-milli take per tick), P128 256 (128 percent, the first rung past one
# take), P256 512 (256 percent). Under the other order (youngest first,
# physiology.intake_order descending): P1D at the shipped 2, P128D and
# P256D at the two rungs past a take. Decides which rung is the top dose
# (the highest at which every world is generable and none trips the
# entity-cap gate), calibrates the SESOI, and measures the cost per world;
# no other decision is read from it.
campaign phase23-production-pilot
ticks 100000
workers 8
seeds 23901..23904
check-interval 10000
base preset phase2
base cells_x 64
base cells_y 64
base initial_organisms 0
base max_entities 4000
base origin.mode scratch
base genome2.enabled true
base genome2.mutation.duplication_q16 6554
base genome2.mutation.deletion_q16 655
base genome2.mutation.insertion_q16 0
base genome2.mutation.transposition_q16 0
base genome2.caps.max_loci_per_chromosome 160
base genome2.caps.max_nodes 160
base genome2.caps.max_edges 160
base genome2.caps.max_edges_per_node 32
base genome2.caps.max_genome_bytes 16384
base morphology.enabled true
base morphology.caps.max_modules 64
base morphology.caps.lattice_radius 8
base morphology.caps.max_growth_steps 16
base morphology.base_node_budget 4
base chemistry.enabled true
base chemistry.field_steps_per_tick 1
base chemistry.microbial_enabled true
base chemistry.abiogenesis_enabled true
base chemistry.mutation_q16 4096
base chemistry.excretion_fraction_q16 32768
base chemistry.remains_fraction_q16 32768
base transition.enabled true
base transition.check_interval_ticks 100
base transition.density_floor_milli 4000
base transition.persistence_checks 5
base transition.aggregation_step_min 1
base transition.organism_energy_milli 4000
base transition.max_organisms_per_event 4
base transition.max_materializations_per_tick 64
base chemistry.consumption_fraction_q16 65536
condition P1
condition P4
set P4 chemistry.production_milli_per_step 8
condition P16
set P16 chemistry.production_milli_per_step 32
condition P64
set P64 chemistry.production_milli_per_step 128
condition P128
set P128 chemistry.production_milli_per_step 256
condition P256
set P256 chemistry.production_milli_per_step 512
condition P1D
set P1D physiology.intake_order descending
condition P128D
set P128D chemistry.production_milli_per_step 256
set P128D physiology.intake_order descending
condition P256D
set P256D chemistry.production_milli_per_step 512
set P256D physiology.intake_order descending
vary chemistry.production_milli_per_step
vary physiology.intake_order
output events on
output snapshots on
output field 1000
