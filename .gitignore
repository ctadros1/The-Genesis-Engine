# Planning repository: keep generated results and local data out of version control.
.DS_Store
# Local agent tooling caches (vendored third-party skills), not project content.
# The six project-specific genesis-* skills are tracked: they carry the
# commissioned research reviews that govern engine design (ADR-0022).
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/genesis-*
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/genesis-*
skills-lock.json
target/
node_modules/
dist/
.phase0-tools/
.env
.env.*
!.env.example
data/
saves/
exports/
benchmarks/raw/
# Campaign artifacts are large and regenerable from the campaign file plus
# the recorded seeds. The definitions and the reports under
# experiments/results/ are tracked; the .alss/.alev/.alif output is not.
experiments/runs/
*.alss
*.alev
*.alif
benchmarks/screenshots/
coverage/
playwright-report/
test-results/
